<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="PLT" constructor="BlobAttachmentViewer" version="1.0.19"
           display-name-key="Blob Attachment Viewer"
           description-key="Lists email attachments stored in Azure Blob Storage and opens them via short-lived SAS URLs."
           control-type="virtual">
    <external-service-usage enabled="true">
      <domain>*.blob.core.windows.net</domain>
    </external-service-usage>

    <data-set name="attachments" display-name-key="Blob Attachments">
      <property-set name="fileName" display-name-key="File Name" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="mimeType" display-name-key="MIME Type" of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="fileSize" display-name-key="File Size" of-type="Whole.None" usage="bound" required="false" />
      <property-set name="blobPath" display-name-key="Blob Path" of-type="SingleLine.Text" usage="bound" required="true" />
    </data-set>

    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>